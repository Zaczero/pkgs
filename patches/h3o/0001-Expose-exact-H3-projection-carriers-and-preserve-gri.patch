 use super::{CoordIJK, SQRT3_2, Vec2d, Vec3d};
 use crate::face::{self, FaceOrientIJK};
 use crate::index::bits;
 use crate::{
-    BaseCell, Boundary, CCW, CW, CellIndex, DEFAULT_CELL_INDEX, Direction, ExtendedResolution,
-    Face, NUM_HEX_VERTS, NUM_ICOSA_FACES, NUM_PENT_VERTS, Resolution, Vertex,
+    BaseCell, Boundary, CCW, CW, CapLatticeProfile, CellIndex, DEFAULT_CELL_INDEX, Direction,
+    ExtendedResolution, Face, Hex2Int, NUM_HEX_VERTS, NUM_ICOSA_FACES, NUM_PENT_VERTS,
+    ProjectedBoundary, ProjectionSeam, ProjectionSeed, Resolution, Vertex,
 };
 
 static ZERO: CoordIJK = CoordIJK::new(0, 0, 0);
 
 // -----------------------------------------------------------------------------
 
+// gometry: converts native IJK results into the exact doubled carrier.
+fn hex2int(value: CoordIJK) -> Hex2Int {
+    let i = i64::from(value.i());
+    let j = i64::from(value.j());
+    let k = i64::from(value.k());
+    Hex2Int::new(2 * i - j - k, j - k)
+}
+
+/// Builds the finite native data set which bounds all target descendants.
+///
+/// Every entry is made with the same aperture, neighbour, and rotation
+/// operators used by H3 index decoding.  The profile intentionally preserves
+/// the individual lattice offsets: its certified consumer owns all numeric
+/// norms and projection bounds.
+// gometry: profiles real aperture, neighbor, and rotation operations for A3.
+pub fn cap_lattice_profile(target: Resolution) -> CapLatticeProfile {
+    const ZERO_HEX: Hex2Int = Hex2Int::new(0, 0);
+    const CII_VERTICES: [CoordIJK; 6] = [
+        CoordIJK::new(2, 1, 0),
+        CoordIJK::new(1, 2, 0),
+        CoordIJK::new(0, 2, 1),
+        CoordIJK::new(0, 1, 2),
+        CoordIJK::new(1, 0, 2),
+        CoordIJK::new(2, 0, 1),
+    ];
+    const CIII_VERTICES: [CoordIJK; 6] = [
+        CoordIJK::new(5, 4, 0),
+        CoordIJK::new(1, 5, 0),
+        CoordIJK::new(0, 5, 4),
+        CoordIJK::new(0, 1, 5),
+        CoordIJK::new(4, 0, 5),
+        CoordIJK::new(5, 0, 1),
+    ];
+
+    let target_value = u8::from(target);
+    let adjusted_resolution = target_value + u8::from(target.is_class3());
+    let adjusted_index = usize::from(adjusted_resolution);
+    let max_dim_i32 = MAX_DIM_BY_CII_RES[adjusted_index];
+    let max_dim = i64::from(max_dim_i32);
+    debug_assert!(max_dim > 0);
+
+    let zero_seed = ProjectionSeed::Point {
+        face: 0,
+        point: ZERO_HEX,
+        resolution: adjusted_resolution,
+        substrate: true,
+    };
+    let empty_seam = ProjectionSeam::new([zero_seed; 2], [zero_seed; 2]);
+    let mut suffixes = [[ZERO_HEX; 42]; 15];
+    for digit_value in 1..=target_value {
+        for (direction_index, direction) in Direction::iter().enumerate() {
+            let mut coordinate = direction.coordinate();
+            for finer_value in (digit_value + 1)..=target_value {
+                let finer =
+                    Resolution::try_from(finer_value).expect("target suffix is an H3 resolution");
+                coordinate = if finer.is_class3() {
+                    coordinate.down_aperture7::<{ CCW }>()
+                } else {
+                    coordinate.down_aperture7::<{ CW }>()
+                };
+            }
+            let coordinate = target_substrate_coordinate(coordinate, target);
+            for rotation in 0..6 {
+                suffixes[usize::from(digit_value - 1)][direction_index * 6 + rotation] =
+                    hex2int(rotate_ccw(coordinate, rotation));
+            }
+        }
+    }
+
+    let mut vertices = [ZERO_HEX; 36];
+    let vertex_table = if target.is_class3() {
+        &CIII_VERTICES
+    } else {
+        &CII_VERTICES
+    };
+    for (vertex_index, vertex) in vertex_table.iter().copied().enumerate() {
+        for rotation in 0..6 {
+            vertices[vertex_index * 6 + rotation] = hex2int(rotate_ccw(vertex, rotation));
+        }
+    }
+
+    let mut seams = [empty_seam; 60];
+    let face_vertices = [
+        CoordIJK::new(3 * max_dim_i32, 0, 0),
+        CoordIJK::new(0, 3 * max_dim_i32, 0),
+        CoordIJK::new(0, 0, 3 * max_dim_i32),
+    ];
+    let mut seam_index = 0;
+    for face_index in 0..NUM_ICOSA_FACES {
+        let left_face = Face::new_unchecked(face_index);
+        for edge in [face::IJ, face::KI, face::JK] {
+            let (first, second) = match edge {
+                face::IJ => (face_vertices[0], face_vertices[1]),
+                face::KI => (face_vertices[2], face_vertices[0]),
+                face::JK => (face_vertices[1], face_vertices[2]),
+                _ => unreachable!("only directed face seams are profiled"),
+            };
+            let orientation = face::NEIGHBORS[face_index][edge];
+            let right_first = transform_to_neighbor(first, orientation, adjusted_index);
+            let right_second = transform_to_neighbor(second, orientation, adjusted_index);
+            seams[seam_index] = ProjectionSeam::new(
+                [
+                    projection_seed(left_face, first, adjusted_resolution),
+                    projection_seed(left_face, second, adjusted_resolution),
+                ],
+                [
+                    projection_seed(orientation.face, right_first, adjusted_resolution),
+                    projection_seed(orientation.face, right_second, adjusted_resolution),
+                ],
+            );
+            seam_index += 1;
+        }
+    }
+    debug_assert_eq!(seam_index, seams.len());
+
+    CapLatticeProfile::new(
+        target,
+        adjusted_resolution,
+        max_dim,
+        suffixes,
+        vertices,
+        seams,
+    )
+}
+
+fn target_substrate_coordinate(mut coordinate: CoordIJK, target: Resolution) -> CoordIJK {
+    coordinate = coordinate.down_aperture3::<{ CCW }>();
+    coordinate = coordinate.down_aperture3::<{ CW }>();
+    if target.is_class3() {
+        coordinate = coordinate.down_aperture7::<{ CW }>();
+    }
+    coordinate
+}
+
+fn rotate_ccw(mut coordinate: CoordIJK, rotations: usize) -> CoordIJK {
+    for _ in 0..rotations {
+        coordinate = coordinate.rotate60::<{ CCW }>();
+    }
+    coordinate
+}
+
