+#[test]
+fn fallible_constructors_preserve_values_layout_and_ownership() {
+    Python::attach(|py| {
+        let values = vec![1.25_f64, -3.5, 6.75];
+        let pointer = values.as_ptr();
+        let array = values.try_into_pyarray(py).unwrap();
+        assert_eq!(array.data(), pointer.cast_mut());
+        assert_eq!(array.readonly().as_slice().unwrap(), &[1.25, -3.5, 6.75]);
+        array.try_readwrite().unwrap().make_nonwriteable();
+        assert!(array.try_readwrite().is_err());
+
+        let bools = numpy::PyArray1::try_from_vec(py, vec![true, false, true]).unwrap();
+        assert_eq!(bools.readonly().as_slice().unwrap(), &[true, false, true]);
+        let ints = numpy::PyArray1::try_from_vec(py, vec![-9_i64, 17]).unwrap();
+        assert_eq!(ints.readonly().as_slice().unwrap(), &[-9, 17]);
+        let uints = numpy::PyArray1::try_from_vec(py, vec![u64::MAX, 23]).unwrap();
+        assert_eq!(uints.readonly().as_slice().unwrap(), &[u64::MAX, 23]);
+        let empty = numpy::PyArray1::<u64>::try_from_vec(py, vec![]).unwrap();
+        assert_eq!(empty.len(), 0);
+        let zeros = numpy::PyArray2::<bool>::try_zeros(py, [2, 3], true).unwrap();
+        assert_eq!(zeros.readonly().as_slice().unwrap(), &[false; 6]);
+        assert!(zeros.is_fortran_contiguous());
+
+        let matrix = array![[1.25, 2.5], [3.75, 5.0]].reversed_axes();
+        let pointer = matrix.as_ptr();
+        let numpy = matrix.try_into_pyarray(py).unwrap();
+        assert_eq!(numpy.data(), pointer.cast_mut());
+        assert_eq!(numpy.shape(), &[2, 2]);
+        assert_eq!(numpy.strides(), &[8, 16]);
+        assert_eq!(
+            numpy.readonly().as_array(),
+            array![[1.25, 3.75], [2.5, 5.0]]
+        );
+
+        let readonly = uints.readonly();
+        let view = readonly.as_array();
+        let borrowed = unsafe {
+            numpy::PyArray1::try_borrow_from_array(&view, uints.clone().into_any()).unwrap()
+        };
+        assert_eq!(borrowed.data(), uints.data());
+        assert!(borrowed.getattr("base").unwrap().is(&uints));
+        assert_eq!(borrowed.readonly().as_slice().unwrap(), &[u64::MAX, 23]);
+    });
+}
