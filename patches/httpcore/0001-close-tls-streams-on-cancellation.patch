index 033acef..4adfb52 100644
--- a/tests/test_cancellations.py
+++ b/tests/test_cancellations.py
@@ -1,5 +1,6 @@
+import ssl
 import typing
 
 import anyio
 import hpack
 import hyperframe
@@ -241,5 +242,45 @@ async def test_h2_timeout_during_response():
         with anyio.move_on_after(0.01):
             await conn.request("GET", "http://example.com")
 
         assert not conn.is_closed()
         assert conn.is_idle()
+
+
+@pytest.mark.anyio
+async def test_connection_pool_cancellation_during_tls_handshake_closes_socket():
+    client_hello_received = anyio.Event()
+    peer_closed = anyio.Event()
+
+    async def peer(stream):
+        async with stream:
+            client_hello_prefix = b""
+            while len(client_hello_prefix) < 2:
+                client_hello_prefix += await stream.receive(
+                    2 - len(client_hello_prefix)
+                )
+            assert client_hello_prefix == b"\x16\x03"
+            client_hello_received.set()
+            try:
+                while True:
+                    await stream.receive(65536)
+            except anyio.EndOfStream:
+                peer_closed.set()
+
+    listener = await anyio.create_tcp_listener(local_host="127.0.0.1")
+    port = listener.extra(anyio.abc.SocketAttribute.local_port)
+    async with listener, anyio.create_task_group() as peer_tasks:
+        peer_tasks.start_soon(listener.serve, peer)
+        async with httpcore.AsyncConnectionPool(
+            ssl_context=ssl.create_default_context()
+        ) as pool:
+            async with anyio.create_task_group() as request_tasks:
+                request_tasks.start_soon(
+                    pool.request, "GET", f"https://127.0.0.1:{port}/"
+                )
+                with anyio.fail_after(5):
+                    await client_hello_received.wait()
+                request_tasks.cancel_scope.cancel()
+
+            with anyio.fail_after(5):
+                await peer_closed.wait()
+        peer_tasks.cancel_scope.cancel()
