From aebf08620f76bed5a241ed622dbaf49a1958b059 Mon Sep 17 00:00:00 2001
From: Kamil Monicz <kamil@monicz.dev>
Date: Sun, 18 Oct 2026 13:17:34 +0000
Subject: [PATCH] Close TLS streams when handshakes are cancelled

TLS handshake cancellation bypasses the backend cleanup handlers and leaves the underlying TCP stream open. Shield cleanup for both asyncio and Trio, suppress cleanup failures so the original handshake exception or cancellation propagates, and cover peer-observed closure through AsyncConnectionPool.
---
 CHANGELOG.md                |  1 +
 httpcore/_backends/anyio.py | 10 ++++++---
 httpcore/_backends/trio.py  | 10 ++++++---
 tests/test_cancellations.py | 41 +++++++++++++++++++++++++++++++++++++
 4 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 5761a3c..9fd0868 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -4,10 +4,11 @@ All notable changes to this project will be documented in this file.
 
 The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/).
 
 ## Unreleased
 
+- Close network streams when TLS handshakes are cancelled by asyncio or Trio.
 - Fix `max_keepalive_connections` not being properly handled. (#1000)
 
 ## Version 1.0.9 (April 24th, 2025)
 
 - Resolve https://github.com/advisories/GHSA-vqfr-h8mv-ghfj with h11 dependency update. (#1008)
diff --git a/httpcore/_backends/anyio.py b/httpcore/_backends/anyio.py
index a140095..2868d18 100644
--- a/httpcore/_backends/anyio.py
+++ b/httpcore/_backends/anyio.py
@@ -1,9 +1,10 @@
 from __future__ import annotations
 
 import ssl
 import typing
+from contextlib import suppress
 
 import anyio
 
 from .._exceptions import (
     ConnectError,
@@ -72,13 +73,16 @@ class AnyIOStream(AsyncNetworkStream):
                         ssl_context=ssl_context,
                         hostname=server_hostname,
                         standard_compatible=False,
                         server_side=False,
                     )
-            except Exception as exc:  # pragma: nocover
-                await self.aclose()
-                raise exc
+            except BaseException:
+                # Cancellation must close the raw stream without replacing the handshake failure.
+                with anyio.CancelScope(shield=True):
+                    with suppress(Exception):
+                        await self.aclose()
+                raise
         return AnyIOStream(ssl_stream)
 
     def get_extra_info(self, info: str) -> typing.Any:
         if info == "ssl_object":
             return self._stream.extra(anyio.streams.tls.TLSAttribute.ssl_object, None)
