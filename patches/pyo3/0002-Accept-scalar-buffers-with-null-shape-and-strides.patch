@@ -1,15 +1,48 @@
 import sys
 
 import pytest
 from pyo3_pytests.buf_and_str import (
     BytesExtractor,
+    ScalarBuffer,
     compatible_f64_format,
     return_memoryview,
+    scalar_buffer_roundtrip,
 )
 
 
+@pytest.mark.parametrize("explicit_release", [False, True], ids=["drop", "release"])
+def test_scalar_buffer_roundtrip(explicit_release):
+    value = ScalarBuffer(1.25)
+    info = scalar_buffer_roundtrip(value, explicit_release)
+    assert info == {
+        "dimensions": 0,
+        "item_count": 1,
+        "shape": [],
+        "strides": [],
+        "suboffsets": None,
+        "c_contiguous": True,
+        "f_contiguous": True,
+        "c_slice_len": 1,
+        "f_slice_len": 1,
+        "scalar_pointer": True,
+        "c_values": [1.25],
+        "f_values": [1.25],
+        "c_copy": [1.25],
+        "f_copy": [1.25],
+        "c_written": [3.5],
+        "f_written": [4.5],
+    }
+    assert value.value == 4.5
+    assert value.releases == 1
+
+
+def test_scalar_memoryview_typed_acquisition():
+    scalar = memoryview(bytearray(b"x")).cast("B", shape=[])
+    assert BytesExtractor.from_buffer(scalar) == 1
+
+
 @pytest.mark.parametrize(
     ("format", "expected"),
     [
         ("d", True),
         ("@d", True),
