     pub fn strides(&self) -> &[isize] {
-        unsafe { slice::from_raw_parts(self.raw().strides, self.raw().ndim as usize) }
+        if self.raw().ndim == 0 {
+            &[]
+        } else {
+            unsafe { slice::from_raw_parts(self.raw().strides, self.raw().ndim as usize) }
