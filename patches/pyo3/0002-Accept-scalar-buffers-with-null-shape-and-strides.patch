diff --git a/pytests/src/buf_and_str.rs b/pytests/src/buf_and_str.rs
index d0b42204..f642cdfc 100644
--- a/pytests/src/buf_and_str.rs
+++ b/pytests/src/buf_and_str.rs
@@ -3,21 +3,95 @@
 use pyo3::prelude::*;
 
 /// Objects related to PyBuffer and PyStr
 #[pymodule]
 pub mod buf_and_str {
-    use pyo3::buffer::PyBuffer;
+    use pyo3::buffer::{PyBuffer, PyUntypedBuffer};
     use pyo3::prelude::*;
-    use pyo3::types::{PyBytes, PyMemoryView, PyString};
+    use pyo3::types::{PyBytes, PyDict, PyMemoryView, PyString};
     use std::borrow::Cow;
 
     #[pyfunction]
     fn compatible_f64_format(format: &str) -> bool {
         let format = std::ffi::CString::new(format).unwrap();
         <f64 as pyo3::buffer::Element>::is_compatible_format(&format)
     }
 
+    #[pyclass]
+    struct ScalarBuffer {
+        #[pyo3(get)]
+        value: f64,
+        #[pyo3(get)]
+        releases: usize,
+    }
+
+    #[pymethods]
+    impl ScalarBuffer {
+        #[new]
+        fn new(value: f64) -> Self {
+            Self { value, releases: 0 }
+        }
+
+        unsafe fn __getbuffer__(
+            slf: PyRefMut<'_, Self>,
+            view: *mut pyo3::ffi::Py_buffer,
+            _flags: std::ffi::c_int,
+        ) {
+            let data = std::ptr::addr_of!(slf.value).cast_mut().cast();
+            // SAFETY: view points to the consumer's output buffer. The owned
+            // exporter reference pins the scalar until the view is released.
+            unsafe {
+                *view = pyo3::ffi::Py_buffer::new();
+                (*view).buf = data;
+                (*view).len = std::mem::size_of::<f64>() as isize;
+                (*view).itemsize = std::mem::size_of::<f64>() as isize;
+                (*view).format = c"d".as_ptr().cast_mut();
+                (*view).obj = slf.into_ptr();
+            }
+        }
+
+        unsafe fn __releasebuffer__(mut slf: PyRefMut<'_, Self>, _view: *mut pyo3::ffi::Py_buffer) {
+            slf.releases += 1;
+        }
+    }
+
+    #[pyfunction]
+    fn scalar_buffer_roundtrip<'py>(
+        value: &Bound<'py, PyAny>,
+        explicit_release: bool,
+    ) -> PyResult<Bound<'py, PyDict>> {
+        let py = value.py();
+        let buffer = PyUntypedBuffer::get(value)?;
+        let typed = buffer.as_typed::<f64>()?;
+        let info = PyDict::new(py);
+        info.set_item("dimensions", typed.dimensions())?;
+        info.set_item("item_count", typed.item_count())?;
+        info.set_item("shape", typed.shape())?;
+        info.set_item("strides", typed.strides())?;
+        info.set_item("suboffsets", typed.suboffsets())?;
+        info.set_item("c_contiguous", typed.is_c_contiguous())?;
+        info.set_item("f_contiguous", typed.is_fortran_contiguous())?;
+        info.set_item("c_slice_len", typed.as_slice_ptr().unwrap().len())?;
+        info.set_item("f_slice_len", typed.as_fortran_slice_ptr().unwrap().len())?;
+        info.set_item("scalar_pointer", typed.get_ptr(&[]) == typed.buf_ptr())?;
+        info.set_item("c_values", typed.to_vec(py)?)?;
+        info.set_item("f_values", typed.to_fortran_vec(py)?)?;
+        let mut copied = [0.0];
+        typed.copy_to_slice(py, &mut copied)?;
+        info.set_item("c_copy", copied)?;
+        typed.copy_to_fortran_slice(py, &mut copied)?;
+        info.set_item("f_copy", copied)?;
+        typed.copy_from_slice(py, &[3.5])?;
+        info.set_item("c_written", typed.to_vec(py)?)?;
+        typed.copy_from_fortran_slice(py, &[4.5])?;
+        info.set_item("f_written", typed.to_vec(py)?)?;
+        if explicit_release {
+            buffer.release(py);
+        }
+        Ok(info)
+    }
+
     /// This is for confirming that PyBuffer does not cause memory leak
     #[pyclass]
     struct BytesExtractor {}
 
     #[pymethods]
