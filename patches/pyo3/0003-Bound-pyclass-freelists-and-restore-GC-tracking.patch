+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn check_capacity<const N: usize>() {
+        let mut allocations = [0_u8; 18];
+        let pointers = core::array::from_fn::<_, 18, _>(|i| {
+            NonNull::from(&mut allocations[i]).cast::<ffi::PyObject>()
+        });
