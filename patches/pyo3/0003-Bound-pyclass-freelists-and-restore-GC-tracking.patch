+            for &ptr in &pointers[..N] {
+                assert_eq!(list.insert(ptr), None, "capacity {N}");
+            }
+            assert_eq!(list.insert(pointers[N]), Some(pointers[N]));
+            for &ptr in pointers[..N].iter().rev() {
+                assert_eq!(list.pop(), Some(ptr));
+            }
+            assert_eq!(list.pop(), None);
+        }
+    }
+
