Subject: [PATCH] Use parking_lot 0.13 and lock_api 0.5

Apply after the source-package integration patch. Keep PyO3's synchronization
extensions on the same lock types as the workspace.

diff --git a/pyo3/Cargo.toml b/pyo3/Cargo.toml
--- a/pyo3/Cargo.toml
+++ b/pyo3/Cargo.toml
@@ -432,3 +432,3 @@
 [dependencies.lock_api]
-version = "0.4"
+version = "0.5"
 optional = true
@@ -460,3 +460,3 @@
 [dependencies.parking_lot]
-version = "0.12"
+version = "0.13"
 optional = true
@@ -507,3 +507,3 @@
 [dev-dependencies.parking_lot]
-version = "0.12.3"
+version = "0.13"
 features = ["arc_lock"]
diff --git a/pyo3/Cargo.toml.orig b/pyo3/Cargo.toml.orig
--- a/pyo3/Cargo.toml.orig
+++ b/pyo3/Cargo.toml.orig
@@ -70,2 +70,2 @@
-lock_api = { version = "0.4", optional = true }
-parking_lot = { version = "0.12", optional = true }
+lock_api = { version = "0.5", optional = true }
+parking_lot = { version = "0.13", optional = true }
@@ -90 +90 @@
-parking_lot = { version = "0.12.3", features = ["arc_lock"] }
+parking_lot = { version = "0.13", features = ["arc_lock"] }
diff --git a/pyo3/src/sync.rs b/pyo3/src/sync.rs
--- a/pyo3/src/sync.rs
+++ b/pyo3/src/sync.rs
@@ -759,4 +759,4 @@
     #[cfg(feature = "lock_api")]
-    impl<R, G, T> Sealed<T> for lock_api::ReentrantMutex<R, G, T> {}
+    impl<R: lock_api::RawMutex, G, T> Sealed<T> for lock_api::ReentrantMutex<R, G, T> {}
     #[cfg(feature = "arc_lock")]
-    impl<R, G, T> Sealed<T> for alloc::sync::Arc<lock_api::ReentrantMutex<R, G, T>> {}
+    impl<R: lock_api::RawMutex, G, T> Sealed<T> for alloc::sync::Arc<lock_api::ReentrantMutex<R, G, T>> {}
