+    ("format", "expected"),
+    [
+        ("d", True),
+        ("@d", True),
+        ("=d", True),
+        ("<d", sys.byteorder == "little"),
+        (">d", sys.byteorder == "big"),
+        ("!d", sys.byteorder == "big"),
+    ],
+)
+def test_compatible_f64_format_byte_order(format, expected):
+    assert compatible_f64_format(format) is expected
 
 
