+    #[test]
+    fn test_element_format_byte_order() {
+        fn check<T: Element>(formats: [&CStr; 6]) {
+            for (format, expected) in formats.into_iter().zip([
+                true,
+                true,
+                true,
+                cfg!(target_endian = "little"),
+                cfg!(target_endian = "big"),
+                cfg!(target_endian = "big"),
+            ]) {
+                assert_eq!(
+                    T::is_compatible_format(format),
+                    expected,
+                    "{}: {format:?}",
+                    core::any::type_name::<T>()
+                );
+            }
+        }
+
+        check::<i8>([c"b", c"@b", c"=b", c"<b", c">b", c"!b"]);
+        check::<u8>([c"B", c"@B", c"=B", c"<B", c">B", c"!B"]);
+        check::<i16>([c"h", c"@h", c"=h", c"<h", c">h", c"!h"]);
+        check::<u16>([c"H", c"@H", c"=H", c"<H", c">H", c"!H"]);
+        check::<i32>([c"i", c"@i", c"=i", c"<i", c">i", c"!i"]);
+        check::<u32>([c"I", c"@I", c"=I", c"<I", c">I", c"!I"]);
+        check::<i64>([c"q", c"@q", c"=q", c"<q", c">q", c"!q"]);
+        check::<u64>([c"Q", c"@Q", c"=Q", c"<Q", c">Q", c"!Q"]);
+        check::<f32>([c"f", c"@f", c"=f", c"<f", c">f", c"!f"]);
+        check::<f64>([c"d", c"@d", c"=d", c"<d", c">d", c"!d"]);
+    }
+
